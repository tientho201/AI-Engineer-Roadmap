# Sao chép file này thành .env rồi điền key thật:
#   cp .env.example .env
#
# Lấy API key tại: https://platform.openai.com/api-keys
# KHÔNG commit file .env lên git.

OPENAI_API_KEY=sk-your-openai-api-key-here

