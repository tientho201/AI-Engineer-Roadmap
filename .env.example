# Sao chép file này thành .env rồi điền key thật:
#   cp .env.example .env
#
# Lấy API key tại: https://platform.openai.com/api-keys
# KHÔNG commit file .env lên git.

OPENAI_API_KEY=sk-your-openai-api-key-here

# Dùng cho Demo6-anthropic.py (prompt caching Claude)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Dùng cho Demo18.py (Langfuse tracing/observability)
# Đăng ký miễn phí tại https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
# Chỉ cần đổi nếu bạn tự host Langfuse, mặc định là cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
